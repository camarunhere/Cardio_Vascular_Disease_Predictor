# Copy this file to server/.env and fill in your values.
# npm start automatically loads server/.env if it exists.

# MongoDB Atlas connection string (Database → Connect → Drivers).
# Replace <user>, <password> and the cluster host with yours.
# While this is unset/commented, the app runs a local MongoDB automatically.
#MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Secret used to sign login tokens — set a long random string in production.
#JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional overrides
#PORT=8000
#ML_SERVICE_URL=http://127.0.0.1:8001
