{
  "name": "cvd-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js + Express + MongoDB backend for the AI-Based Cardiovascular Disease Prediction Website",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate:atlas": "node --env-file-if-exists=.env scripts/migrateToAtlas.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.2",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0"
  }
}
