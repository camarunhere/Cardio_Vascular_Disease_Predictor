# ── Secrets — never commit ────────────────────────────────────────────────────
server/.env
*.env
!*.env.example

# ── Data (patient uploads, local MongoDB) ─────────────────────────────────────
# Everything under data/ is ignored by default (patient uploads, local Mongo
# storage), except the three training/benchmark datasets, tracked so a fresh
# clone doesn't need Kaggle/UCI access to retrain the model.
data/*
!data/cardio_train.csv
!data/cardio_extended.csv
!data/uci_heart_disease_raw.csv

# ── Trained model artifacts (regenerate with: python -m src.augment && python -m src.train_extended)
models/*.joblib
models/*.json

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.venv/
venv/

# ── CatBoost auto-generated training logs ──────────────────────────────────────
catboost_info/

# ── Build output ──────────────────────────────────────────────────────────────
frontend/dist/
__pycache__/
*.pyc

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
*.log
npm-debug.log*
.idea/
.vscode/
